{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lefinor",
  "compatibility_date": "2026-09-04",
  "main": "worker.js",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    // Por defecto, Cloudflare sirve los assets que coinciden con un archivo real
    // directamente desde su borde, sin pasar por el fetch() del Worker -- por eso las
    // cabeceras de seguridad (worker.js: conCabecerasDeSeguridad, agregadas en el PR #32)
    // nunca llegaban a ninguna página real, solo a rutas que no son un asset (ej. un 404
    // real, o /api/contacto). run_worker_first fuerza a que TODA petición pase primero por
    // el Worker -- inclusive las que sí son un asset -- para que esas cabeceras se apliquen
    // siempre. Contrapartida: cada carga de página pasa por el Worker en vez de servirse
    // directo del borde, con algo de latencia extra por petición.
    "run_worker_first": true
  }

  // PENDIENTE — Activar el límite de tasa de POST /api/contacto.
  //
  // worker.js ya trae la lógica completa (dentroDelLimiteDeTasa: 5 envíos por IP cada 15
  // minutos), pero está inactiva porque falta este binding: sin él, env.RATE_LIMIT_KV es
  // undefined y la función devuelve true siempre, dejando el endpoint sin ningún límite.
  //
  // El bloque va comentado a propósito, no con un id de relleno: wrangler valida el id del
  // namespace al desplegar, así que un valor inventado haría fallar el deploy y dejaría el
  // sitio sin actualizar. Descomentar solo cuando el id real esté a mano.
  //
  // Pasos:
  //   1. npx wrangler kv namespace create RATE_LIMIT_KV
  //   2. Copiar el id que imprime el comando.
  //   3. Descomentar el bloque de abajo y pegar ese id en "id".
  //   4. Desplegar.
  //
  // ,"kv_namespaces": [
  //   {
  //     "binding": "RATE_LIMIT_KV",
  //     "id": "<pegar aqui el id que devuelve el comando del paso 1>"
  //   }
  // ]
}
