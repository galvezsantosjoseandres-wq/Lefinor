{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lefinor",
  "compatibility_date": "2026-09-04",
  "main": "worker.js",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    // Por defecto, Cloudflare sirve los assets que coinciden con un archivo real
    // directamente desde su borde, sin pasar por el fetch() del Worker -- por eso las
    // cabeceras de seguridad (worker.js: conCabecerasDeSeguridad, agregadas en el PR #32)
    // nunca llegaban a ninguna página real, solo a rutas que no son un asset (ej. un 404
    // real, o /api/contacto). run_worker_first fuerza a que TODA petición pase primero por
    // el Worker -- inclusive las que sí son un asset -- para que esas cabeceras se apliquen
    // siempre. Contrapartida: cada carga de página pasa por el Worker en vez de servirse
    // directo del borde, con algo de latencia extra por petición.
    "run_worker_first": true
  },

  // Activa el límite de tasa de POST /api/contacto (5 envíos por IP cada 15 minutos, ya
  // implementado en worker.js). El binding se llama RATE_LIMIT_KV -- así lo lee worker.js --
  // independientemente de que el namespace se llame distinto en el dashboard de Cloudflare
  // ("LEFINOR_RATE_LIMIT_KV"): el nombre del binding es lo único que importa para el código.
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT_KV",
      "id": "4a6473273146442a889f12daffa18a18"
    }
  ],

  // Obligatorio bajo Worker Previews, aunque quede vacío (confirmado en
  // developers.cloudflare.com/workers/previews/configuration/): sin esta clave, Preview no
  // hereda ni siquiera la configuración de nivel superior (como `assets`), y el deployment
  // de preview queda sin nada que servir. RATE_LIMIT_KV no se duplica acá a propósito --
  // worker.js ya tolera que env.RATE_LIMIT_KV no exista (el rate limit simplemente no se
  // aplica en preview); si en algún momento se necesita probarlo ahí, hace falta crear un
  // KV namespace aparte para preview y añadirlo como previews.kv_namespaces (nunca apuntar
  // al mismo namespace de producción).
  "previews": {}
}
